{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs dev",
    "dev:small-heap": "nuxt dev",
    "dev:fresh": "npm run clean && npm run dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "node -e \"const fs=require('fs');for(const p of ['.nuxt','.output','.vercel/output','node_modules/.vite','node_modules/.cache']){try{fs.rmSync(p,{recursive:true,force:true});console.log('removed',p)}catch(e){console.log('skip',p,e.message)}}\"",
    "data:import-resultado-json-2026": "npx tsx scripts/import-resultado-json-2026.ts",
    "data:refresh": "npm run data:import-resultado-json-2026 && npm run embeddings",
    "embeddings": "npx tsx scripts/generate-embeddings.ts",
    "embeddings:institutions": "npx tsx scripts/generate-embeddings.ts --table=institutions",
    "embeddings:careers": "npx tsx scripts/generate-embeddings.ts --table=career_generic",
    "embeddings:programs": "npx tsx scripts/generate-embeddings.ts --table=programs",
    "embeddings:reset": "npx tsx scripts/generate-embeddings.ts --reset"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.3",
    "nuxt": "^4.4.4",
    "pinia": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
